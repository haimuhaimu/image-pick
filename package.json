{
  "name": "image-pick",
  "version": "0.1.0",
  "description": "A local-first visual review checkpoint for AI agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "image-pick": "bin/image-pick.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "skills",
    "scripts/demo.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/assets",
    "docs/contract.md",
    "docs/integrations.md",
    "docs/rereview-demo.md",
    "docs/verification.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "demo": "node scripts/demo.mjs && node bin/image-pick.mjs serve .image-pick/demo/album.json",
    "demo:handoff": "node scripts/demo.mjs --handoff && node bin/image-pick.mjs serve .image-pick/handoff-demo/album.json",
    "demo:rereview": "node scripts/demo.mjs --rereview && node bin/image-pick.mjs serve .image-pick/rereview-demo/album.json --context .image-pick/rereview-demo/context.json --reviews .image-pick/rereview-demo/reviews",
    "check": "npm test && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haimuhaimu/image-pick.git"
  },
  "keywords": [
    "image-review",
    "photo-selection",
    "visual-feedback",
    "human-in-the-loop",
    "agent-skills",
    "codex",
    "deepseek-harness",
    "local-first"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
